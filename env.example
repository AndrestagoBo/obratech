# Copia este archivo a .env.local y reemplaza los tres valores.
# Nunca escribas aquí las claves reales: este archivo sí se sube al repositorio.

# Panel admin. Genera valores largos y aleatorios con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# El sitio se niega a iniciar sesión si faltan o si son valores de ejemplo.
# Si la olvidas, en este computador abre /admin/recuperar y elige otra.
# Esa queda en data/admin-password.json y reemplaza a este valor.
ADMIN_PASSWORD=REEMPLAZAR_por_una_clave_larga_y_aleatoria
ADMIN_SECRET=REEMPLAZAR_por_otro_secreto_largo_y_aleatorio

# Dominio real del sitio. Si falta, las imágenes de WhatsApp/Facebook y los
# datos de Google apuntan a localhost:3000 y no funcionan en producción.
# Tiene que estar definida antes de correr `npm run build`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
